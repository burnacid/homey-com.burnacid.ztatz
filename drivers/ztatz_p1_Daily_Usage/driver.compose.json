{
  "name": {
    "en": "P1 Daily Usage",
    "nl": "P1 Dagelijks verbruik"
  },
  "class": "other",
  "capabilities": [
    "meter_gas.consumed_today",
    "meter_power.consumed_today",
    "meter_power.production_today",
    "meter_water.consumed_today"
  ],
  "capabilitiesOptions": {
    "meter_gas.consumed_today": {
      "title": {
        "nl": "Verbruik gas vandaag",
        "en": "Gas usage today"
      },
      "decimals": 2,
      "color": "#40e8d4"
    },
    "meter_power.consumed_today": {
      "title": {
        "nl": "Verbruik elektriciteit vandaag",
        "en": "Electricity usage today"
      },
      "decimals": 3,
      "color": "#c2ad38"
    },
    "meter_power.production_today": {
      "title": {
        "nl": "Teruglevering elektriciteit vandaag",
        "en": "Electricity production today"
      },
      "decimals": 3,
      "color": "#e8cf40"
    },
    "meter_water.consumed_today": {
      "title": {
        "nl": "Verbruik water vandaag ",
        "en": "Water usage today"
      },
      "decimals": 3,
      "color": "#e8cf40",
      "units": {
        "en": "Liter",
        "nl": "Liter"
      }
    }
  },
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "General Info",
        "nl": "Algemene Info"
      },
      "children": [
        {
          "id": "url",
          "type": "label",
          "label": {
            "en": "URL",
            "nl": "URL"
          },
          "value": ""
        },
        {
          "id": "waterMeterId",
          "type": "dropdown",
          "value": "1",
          "label": {
            "en": "Water meter",
            "nl": "Watermeter"
          },
          "hint": {
            "en": "Which ZTATZ water meter to use. It is detected automatically when the device is added.",
            "nl": "Welke ZTATZ watermeter gebruikt wordt. Dit wordt automatisch bepaald bij het toevoegen."
          },
          "values": [
            {
              "id": "1",
              "label": {
                "en": "1 - pulse meter (GPIO)",
                "nl": "1 - pulsmeter (GPIO)"
              }
            },
            {
              "id": "2",
              "label": {
                "en": "2 - digital meter (P1 telegram)",
                "nl": "2 - digitale meter (P1 telegram)"
              }
            }
          ]
        },
        {
          "id": "apiKey",
          "type": "password",
          "value": "",
          "label": {
            "en": "API key",
            "nl": "API sleutel"
          },
          "hint": {
            "en": "Only needed when ZTATZ is reached over HTTPS (internet access with API tokens). Leave empty on your local network.",
            "nl": "Alleen nodig wanneer ZTATZ via HTTPS benaderd wordt (internet toegang met API tokens). Laat leeg op je lokale netwerk."
          }
        },
        {
          "id": "debug",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Debug Mode"
          },
          "hint": {
            "en": "Only enable this when troubleshooting issues, this generates extra logs for diagnostic reports. This will be disabled when the app is restarted!",
            "nl": "Zet deze setting alleen aan wanneer je problemen probeert op te lossen, dit genereert extra logs voor diagnostische rapportages. Dit wordt uitgeschakeld wanneer de app wordt herstart!"
          }
        }
      ]
    }
  ],
  "pair": [
    {
      "id": "start"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "images": {
    "large": "/drivers/ztatz_p1_Usage/assets/images/large.jpg",
    "small": "/drivers/ztatz_p1_Usage/assets/images/small.jpg"
  }
}
